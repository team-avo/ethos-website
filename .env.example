# Copy to .env.local and fill in values
# Never commit .env.local

# Site — the canonical origin. On Vercel set this to the preview URL first,
# then to https://www.ethosrecovery.com at go-live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager — leave UNSET on the preview deployment so preview traffic
# doesn't pollute analytics. At go-live, set this to the live container:
#   NEXT_PUBLIC_GTM_ID=GTM-PC8G46L8
# NEXT_PUBLIC_GTM_ID=
